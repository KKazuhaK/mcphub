# Add to the existing MCPHub container; preserve all existing settings and secrets.
MCPHUB_PUBLIC_URL=https://mcp.kazuhahub.com
# Exact HTTPS institution origins only, comma-separated. No /api/v1 path here.
MCPHUB_CANVAS_ORIGINS=https://canvas.eee.uci.edu
MCPHUB_SMTP_HOST=smtp.example.com
MCPHUB_SMTP_PORT=587
MCPHUB_SMTP_SECURE=false
MCPHUB_SMTP_USER=
MCPHUB_SMTP_PASSWORD=
MCPHUB_SMTP_FROM=MCPHub <notifications@example.com>
